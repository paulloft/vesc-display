<globals>
  <consts>
    <color name="color_bg" value="0x06121e" />
    <color name="color_text" value="0xe9f4ff" />
    <color name="color_muted" value="0x90a9bc" />
    <color name="color_cyan" value="0x27c4f5" />
    <color name="color_red" value="0xff6554" />
  </consts>
  <subjects>
    <int name="ui_speed_value" value="42" />
    <int name="ui_battery" value="82" />
    <int name="ui_mode" value="1" />
    <int name="ui_limit" value="50" />
    <int name="ui_meter" value="0" />
    <int name="ui_hazard" value="0" />
    <int name="ui_blink_on" value="450" />
    <int name="ui_blink_off" value="450" />
    <int name="ui_hold" value="2000" />
    <int name="ui_double" value="300" />
    <int name="ui_flip" value="0" />
    <int name="ui_motion" value="0" />
    <int name="ui_cruise" value="0" />
    <int name="ui_safe" value="1" />
    <string name="ui_mode_text" value="Drive" />
    <string name="ui_notice" value="ПРЕДПРОСМОТР · тестовые показания" />
  </subjects>
  <images>
    <convert src="images/background-source.png" dest="images/background.png" width="480" height="320" />
    <data name="ui_img_background" src_path="images/background.png" color_format="rgb565" />
    <data name="ui_img_left" src_path="images/left.png" color_format="a8" />
    <data name="ui_img_right" src_path="images/right.png" color_format="a8" />
    <data name="ui_img_position" src_path="images/position.png" color_format="a8" />
    <data name="ui_img_low_beam" src_path="images/low_beam.png" color_format="a8" />
    <data name="ui_img_high_beam" src_path="images/high_beam.png" color_format="a8" />
    <data name="ui_img_brake" src_path="images/brake.png" color_format="a8" />
    <data name="ui_img_warning" src_path="images/warning.png" color_format="a8" />
    <data name="ui_img_hazard" src_path="images/hazard.png" color_format="a8" />
    <data name="ui_img_battery" src_path="images/battery.png" color_format="a8" />
    <data name="ui_img_thermometer" src_path="images/thermometer.png" color_format="a8" />
    <data name="ui_img_switch_track" src_path="images/switch_track.png" color_format="a8" />
    <data name="ui_img_switch_knob" src_path="images/switch_knob.png" color_format="a8" />
  </images>
  <fonts>
    <bin name="ui_small" src_path="fonts/NotoSans.ttf" size="14" bpp="4" as_file="false" range="0x20-0x7f,0x400-0x45f" symbols="°−—…·" />
    <bin name="ui_medium" src_path="fonts/Dashboard-Bold.ttf" size="20" bpp="4" as_file="false" range="0x20-0x7f,0x400-0x45f" symbols="°−—…·" />
    <bin name="ui_value" src_path="fonts/Dashboard-Bold.ttf" size="32" bpp="4" as_file="false" range="0x20-0x7f" symbols="°−—…·" />
    <bin name="ui_speed" src_path="fonts/Dashboard-Bold.ttf" size="72" bpp="4" as_file="false" range="0x2d,0x30-0x39" symbols="°−—…·" />
  </fonts>
  <styles>
    <style name="card" bg_color="#color_bg" bg_opa="92%" border_color="0x315870" border_width="1" radius="12" pad_all="0" />
    <style name="button" bg_color="0x112b3d" bg_grad_color="0x050e18" bg_grad_dir="ver" bg_opa="100%" border_color="0x37647e" border_width="1" radius="10" pad_all="0" shadow_width="0" />
    <style name="selected" bg_color="0x084b69" border_color="#color_cyan" border_width="2" />
    <style name="limit_selected" bg_color="0x491b20" border_color="#color_red" border_width="2" />
    <style name="battery_fill_style" bg_color="0x31f29a" />
    <style name="arc_indicator" arc_color="#color_red" arc_width="8" />
    <style name="arc_knob" bg_opa="0%" border_width="0" shadow_width="0" />
    <style name="minor_ticks" length="6" line_width="1" line_color="0x91b1c6" line_opa="50%" />
    <style name="major_ticks" length="13" line_width="2" line_color="0xc5dfef" text_font="ui_small" text_color="0xbcd8ea" />
    <style name="dot_selected_0" bg_color="#color_cyan" width="16" />
    <style name="dot_selected_1" bg_color="#color_cyan" width="16" />
    <style name="dot_selected_2" bg_color="#color_cyan" width="16" />
    <style name="clear" bg_opa="0%" border_width="0" pad_all="0" shadow_width="0" radius="0" />
    <style name="switch_track" radius="100" bg_opa="0%" border_width="0" pad_all="0" shadow_width="0" bg_image_src="ui_img_switch_track" bg_image_recolor="0x243c4d" bg_image_recolor_opa="100%" />
    <style name="switch_indicator" radius="100" bg_opa="0%" border_width="0" />
    <style name="switch_on" bg_image_recolor="#color_cyan" />
    <style name="switch_knob" radius="100" bg_opa="0%" border_width="0" pad_all="-4" shadow_width="0" bg_image_src="ui_img_switch_knob" bg_image_recolor="#color_text" bg_image_recolor_opa="100%" />
  </styles>
</globals>
