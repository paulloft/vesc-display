<component>
  <view extends="lv_obj" width="480" height="320" scrollable="false" style_text_font="ui_small" style_bg_opa="100%" style_bg_color="#color_bg">
    <style name="clear" />
    <lv_label name="settings_title" text="НАСТРОЙКИ" x="12" y="28" width="300" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" />
    <lv_obj name="settings_list" x="4" y="57" width="472" height="211" scrollable="true">
      <style name="clear" />
      <lv_label name="timing_title_0" text="Поворотник: включён" x="12" y="16" width="210" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
      <lv_label name="timing_value_0" text="450 мс" x="217" y="16" width="105" style_text_font="ui_small" style_text_color="#color_cyan" clickable="false" bind_text="ui_blink_on" bind_text-fmt="%d мс" style_text_align="right" />
      <lv_button name="timing_minus_0" x="339" y="8" width="52" height="32" scrollable="false">
        <style name="button" />
        <lv_label name="timing_minus_0_text" text="-" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
        <subject_increment_event subject="ui_blink_on" step="-50" min_value="100" max_value="2000" rollover="false" />
      </lv_button>
      <lv_button name="timing_plus_0" x="400" y="8" width="52" height="32" scrollable="false">
        <style name="button" />
        <lv_label name="timing_plus_0_text" text="+" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
        <subject_increment_event subject="ui_blink_on" step="50" min_value="100" max_value="2000" rollover="false" />
      </lv_button>
      <lv_label name="timing_title_1" text="Поворотник: выключен" x="12" y="70" width="210" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
