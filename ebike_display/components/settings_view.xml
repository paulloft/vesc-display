    <lv_label name="settings_hint" text="Изменения действуют сразу" x="12" y="288" width="300" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
    <lv_button name="save_settings" x="335" y="278" width="133" height="38" scrollable="false">
      <style name="button" />
      <lv_label name="save_settings_text" text="Сохранить" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
      <subject_set_string_event subject="ui_notice" value="Изменения сохранены в предпросмотре" />
    </lv_button>
  </view>
</component>
