      <lv_button name="timing_minus_1" x="339" y="62" width="52" height="32" scrollable="false">
        <style name="button" />
        <lv_label name="timing_minus_1_text" text="-" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
        <subject_increment_event subject="ui_blink_off" step="-50" min_value="100" max_value="2000" rollover="false" />
      </lv_button>
      <lv_button name="timing_plus_1" x="400" y="62" width="52" height="32" scrollable="false">
