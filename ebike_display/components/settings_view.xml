      <lv_switch name="flip_switch" x="390" y="216" width="66" height="34" bind_checked="ui_flip" style_bg_color="0x243c4d" style_anim_duration="0">
        <style name="switch_track" />
        <style name="switch_indicator" selector="indicator" />
        <style name="switch_on" selector="checked" />
        <style name="switch_knob" selector="knob" />
      </lv_switch>
      <lv_label name="control_switch_title" text="Управление VESC" x="12" y="271" width="335" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
