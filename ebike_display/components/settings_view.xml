        <style name="switch_track" />
        <style name="switch_indicator" selector="indicator" />
        <style name="switch_on" selector="checked" />
        <style name="switch_knob" selector="knob" />
      </lv_switch>
      <lv_label name="cruise_switch_title" text="Круиз-контроль" x="12" y="321" width="335" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
      <lv_switch name="cruise_switch" x="390" y="316" width="66" height="34" bind_checked="ui_cruise" style_bg_color="0x243c4d" style_anim_duration="0">
        <style name="switch_track" />
        <style name="switch_indicator" selector="indicator" />
        <style name="switch_on" selector="checked" />
        <style name="switch_knob" selector="knob" />
      </lv_switch>
      <lv_label name="safe_switch_title" text="Безопасный режим" x="12" y="371" width="335" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
      <lv_switch name="safe_switch" x="390" y="366" width="66" height="34" bind_checked="ui_safe" style_bg_color="0x243c4d" style_anim_duration="0">
        <style name="switch_track" />
        <style name="switch_indicator" selector="indicator" />
        <style name="switch_on" selector="checked" />
        <style name="switch_knob" selector="knob" />
      </lv_switch>
