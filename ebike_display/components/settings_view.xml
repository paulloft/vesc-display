      <lv_button name="timing_minus_2" x="339" y="116" width="52" height="32" scrollable="false">
        <style name="button" />
        <lv_label name="timing_minus_2_text" text="-" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
        <subject_increment_event subject="ui_hold" step="-100" min_value="500" max_value="5000" rollover="false" />
      </lv_button>
      <lv_button name="timing_plus_2" x="400" y="116" width="52" height="32" scrollable="false">
        <style name="button" />
        <lv_label name="timing_plus_2_text" text="+" x="0" y="0" width="content" style_text_font="ui_medium" style_text_color="#color_text" clickable="false" align="center" />
        <subject_increment_event subject="ui_hold" step="100" min_value="500" max_value="5000" rollover="false" />
      </lv_button>
