        <subject_increment_event subject="ui_blink_off" step="50" min_value="100" max_value="2000" rollover="false" />
      </lv_button>
      <lv_label name="timing_title_2" text="Удержание кнопки" x="12" y="124" width="210" style_text_font="ui_small" style_text_color="#color_text" clickable="false" />
